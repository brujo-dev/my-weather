# Template delle variabili d'ambiente per myWeather.
# Copia questo file in .env e compila i valori reali:
#
#   cp .env.example .env
#
# Per generare una SECRET_KEY sicura:
#   python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=
DATABASE_URI=sqlite:///myweather.db
OPENWEATHER_API_KEY=
FLASK_ENV=development
